# ==========================================
# Telegram Bot Configuration
# ==========================================
# Получите токен у @BotFather в Telegram:
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Список Telegram ID администраторов (через запятую):
ADMIN_IDS=12345678

# Whitelist пользователей. Если пусто — доступ открыт всем.
# Если указать ID через запятую — бот будет отвечать только им:
WHITELIST_IDS=

# ==========================================
# Database & Vector Store
# ==========================================
# Строка подключения к PostgreSQL (например, Neon.tech, Supabase, Render или локальный):
# Поддерживаются как postgresql+asyncpg://, так и postgresql://...neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/readlater

# Принудительное включение/отключение SSL (True/False). 
# По умолчанию None (автоматически включается для Neon, Supabase и при sslmode=require)
DB_SSL=

# Qdrant (опционально, если используется внешний векторный поиск):
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bookmark_chunks

# ==========================================
# 🧠 AI: LLM (DeepSeek для саммари, тегов и анализа)
# ==========================================
# Провайдер LLM: deepseek
LLM_PROVIDER=deepseek
# Модель: deepseek-chat (DeepSeek-V3) — быстрая, умная и дешевая
LLM_MODEL=deepseek-chat

# Ваш API-ключ DeepSeek (получите на https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# 🔍 AI: Embeddings (Поиск)
# ==========================================
# РЕКОМЕНДУЕТСЯ: EMBEDDING_PROVIDER=none
# В этом режиме все рассчитывает DeepSeek, а поиск работает через PostgreSQL.
# Никаких лимитов Gemini 429, никаких сбоев по памяти на Render (512 МБ)!
EMBEDDING_PROVIDER=none

# (Опционально) Если хотите использовать внешние эмбеддинги Gemini или OpenAI:
# EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSy...
# EMBEDDING_DIMENSIONS=768

# ==========================================
# Лимиты и безопасность
# ==========================================
MAX_FILE_SIZE_MB=20
MAX_TEXT_LENGTH=150000
REQUEST_TIMEOUT_SECONDS=15
MAX_REDIRECTS=5
CONCURRENT_WORKERS=3

# ==========================================
# Еженедельный дайджест
# ==========================================
DIGEST_ENABLED=true
DIGEST_DAY_OF_WEEK=0 # 0 = Понедельник
DIGEST_HOUR=10       # 10:00 UTC
